// Translate with an explicit Spanish default (for keys not in the table yet).
inline const char* tr(const char* key, const char* es_default) {
    if (!key) return "";
    std::size_t n = 0;
    const Entry* t = table(n);
    for (std::size_t i = 0; i < n; ++i) {
        if (std::strcmp(t[i].key, key) != 0) continue;
        if (state() == Lang::En && t[i].en) return t[i].en;
        if (t[i].es) return t[i].es;
        break;
    }
    return es_default ? es_default : key;
}

inline const char* tr(const char* key) { return tr(key, key); }

// Translate a Spanish UI literal (incremental wrapping of existing strings). Returns the English
// translation when the language is EN, otherwise the original Spanish text.
struct LitEntry {
    const char* es;
    const char* en;
};
inline const LitEntry* lit_table(std::size_t& count) {
    static const LitEntry kTable[] = {
        // LIT_TABLE_BEGIN
        // LIT_TABLE_END
    };
    count = sizeof(kTable) / sizeof(kTable[0]);
    return kTable;
}
inline const char* tr_lit(const char* es) {
    if (!es) return "";
    if (state() == Lang::Es) return es;
    std::size_t n = 0;
    const LitEntry* t = lit_table(n);
    for (std::size_t i = 0; i < n; ++i)
        if (std::strcmp(t[i].es, es) == 0) return t[i].en;
    return es;
}

} // namespace omsi::ui::i18n
