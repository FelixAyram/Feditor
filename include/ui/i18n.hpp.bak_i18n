#pragma once

#include <cstddef>
#include <cstring>

namespace omsi::ui::i18n {

enum class Lang { Es = 0, En = 1 };

inline Lang& state() {
    static Lang lang = Lang::Es;
    return lang;
}
inline void set_language(Lang l) { state() = l; }
inline Lang language() { return state(); }
inline const char* language_code() { return state() == Lang::En ? "en" : "es"; }

struct Entry {
    const char* key;
    const char* es;
    const char* en;
};

